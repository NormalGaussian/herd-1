#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$( cd "$( dirname "$(readlink -f "${BASH_SOURCE[0]}" )" )" &> /dev/null && pwd )"
CLOOSTERCTL_DIR="$SCRIPT_DIR/../cloosterctl"
SAGGY="$SCRIPT_DIR/saggycli"
SECRETS_DIR="$SCRIPT_DIR/../../secrets"
ORIG_CWD="$(pwd)"

export SOPS_AGE_KEY_FILE="$SECRETS_DIR/age.key"
export PUBLIC_KEYFILE="$SECRETS_DIR/public-age-keys.json"

run_cloosterctl() {
  cd "$CLOOSTERCTL_DIR"
  yarn cloosterctl --basedir "$ORIG_CWD" "$@"
}

if [[ "${1:-}" == "regenerate" ]]; then
  shift

  # Build a temp script that cloosterctl will run inside the decrypted dir
  REGEN_SCRIPT=$(mktemp)
  trap "rm -f $REGEN_SCRIPT" EXIT

  cat > "$REGEN_SCRIPT" <<SCRIPT
#!/bin/bash
set -euo pipefail
cd "$CLOOSTERCTL_DIR"
exec yarn cloosterctl --basedir "$ORIG_CWD" regenerate \\
  --secrets "\$1/talos-secrets.yaml" \\
  --talosdir "\$1/talos.sops" \\
  $(printf '%q ' "$@")
SCRIPT
  chmod +x "$REGEN_SCRIPT"

  $SAGGY with "$SECRETS_DIR/cluster.sops" -w -- "$REGEN_SCRIPT" '{}'
else
  run_cloosterctl "$@"
fi
